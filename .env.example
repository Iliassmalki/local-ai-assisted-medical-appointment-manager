# Copy to .env and fill in. .env is git-ignored and must never be committed.
#
#   cp .env.example .env
#   JWT_SECRET_KEY: openssl rand -base64 32

# Required — the application refuses to start without it.
JWT_SECRET_KEY=

# Database
DB_URL=jdbc:mysql://localhost:3306/appointment
DB_USERNAME=root
DB_PASSWORD=

# Token lifetimes in milliseconds (1 hour / 7 days)
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=604800000

# Assistant (optional — needs a local Ollama runtime)
ASSISTANT_BASE_URL=http://localhost:11434
ASSISTANT_MODEL=mistral
